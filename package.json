{
  "name": "mutascreen",
  "private": true,
  "version": "1.0.0",
  "scripts": {
    "dev": "concurrently -k -n API,WEB -c magenta,cyan \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "uvicorn backend.main:app --reload --host 127.0.0.1 --port 8000",
    "dev:web": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "test:api": "python -m pytest backend/test_scoring.py"
  },
  "dependencies": {
    "framer-motion": "^11.0.0",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^2.15.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "typescript": "^5.7.2",
    "vite": "^6.0.1"
  }
}
